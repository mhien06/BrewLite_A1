generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
}

model User {
  role                UserRole             @default(CUSTOMER)
  inventoryMovements  InventoryMovement[]
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  name                String               @default("KHACH HANG")
  passwordHash        String
  loyaltyPoints       Int                  @default(0)
  createdAt           DateTime             @default(now())
  orders              Order[]
  payments            Payment[]
  requestedRefunds    Refund[]             @relation("RefundRequestedBy")
  retryRequestedRefunds Refund[]            @relation("RefundRetryRequestedBy")
  refundAttempts      RefundAttempt[]       @relation("RefundAttemptInitiatedBy")
  loyaltyTransactions LoyaltyTransaction[]
}

model Product {
  id         Int                 @id @default(autoincrement())
  name       String
  price      Int
  imageUrl   String
  stock      Int                 @default(0)
  orderItems OrderItem[]
  recipes    ProductIngredient[]
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PromotionType {
  PERCENT
  FIXED_AMOUNT
}

enum PaymentMethod {
  WALLET
  CARD
  VNPAY
}

enum CancellationSource {
  CUSTOMER
  STAFF
  SYSTEM
}

model Order {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             OrderStatus         @default(PENDING)
  paymentMethod      PaymentMethod?
  paidAt             DateTime?
  promotionCode      String?
  subtotal           Int                 @default(0)
  discountAmount     Int                 @default(0)
  loyaltyPointsUsed  Int                 @default(0)
  loyaltyDiscountAmount Int              @default(0)
  loyaltyPointsRestored Boolean           @default(false)
  total              Int
  inventoryDeducted  Boolean             @default(false)
  inventorySnapshot  Json?
  cancelledAt        DateTime?
  cancellationSource CancellationSource?
  cancelledById      Int?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]
  loyaltyTransaction LoyaltyTransaction?

  @@index([userId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  size      String
  toppings  String[] @default([])
  quantity  Int
  unitPrice Int
  lineTotal Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Promotion {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  type          PromotionType
  value         Int
  minOrderTotal Int
  maxDiscount   Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
}

model LoyaltyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  orderId   Int      @unique
  points    Int
  reversed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId])
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

enum RefundAttemptType {
  REFUND
  QUERY
}

enum RefundAttemptStatus {
  STARTED
  CONFIRMED
  REJECTED
  AMBIGUOUS
  FAILED
}

model Payment {
  id                        Int           @id @default(autoincrement())
  userId                    Int
  orderId                   Int
  idempotencyKey            String
  method                    PaymentMethod
  simulateSuccess           Boolean?      @default(true)
  amount                    Int
  status                    OrderStatus
  paidAt                    DateTime?
  providerTxnRef            String?       @unique
  providerTransactionNo     String?
  providerResponseCode      String?
  providerTransactionStatus String?
  providerPayDate           String?
  providerBankCode          String?
  expiresAt                 DateTime?
  reconciliationAttempts    Int           @default(0)
  reconciliationNextAt      DateTime?
  reconciliationToken       String?
  reconciliationResult      String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @default(now()) @updatedAt
  user                      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  order                     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund                    Refund?

  @@unique([userId, idempotencyKey])
  @@index([orderId])
  @@index([method, status, reconciliationNextAt])
}

model Refund {
  id           Int          @id @default(autoincrement())
  paymentId    Int          @unique
  orderId      Int
  requestId    String?
  amount       Int
  reason       String
  source       CancellationSource
  status       RefundStatus @default(PENDING)
  requestedAt  DateTime     @default(now())
  submittedAt  DateTime?
  completedAt  DateTime?
  checkedAt    DateTime?
  lastError    String?
  requestedById Int?
  retryRequestedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy  User?        @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  retryRequestedBy User?    @relation("RefundRetryRequestedBy", fields: [retryRequestedById], references: [id], onDelete: SetNull)
  attempts     RefundAttempt[]

  @@index([status, checkedAt])
  @@index([orderId, requestedAt])
}

model RefundAttempt {
  id                         Int                 @id @default(autoincrement())
  refundId                   Int
  attemptNumber              Int
  type                       RefundAttemptType
  status                     RefundAttemptStatus @default(STARTED)
  requestId                  String              @unique
  transactionRef             String
  transactionNo              String?
  transactionDate            DateTime
  amount                     Int
  transactionType            String?
  responseId                 String?
  responseCode               String?
  responseMessage            String?
  responseTransactionNo      String?
  responsePayDate            String?
  responseTransactionStatus  String?
  initiatedById              Int?
  initiatedBy                User?               @relation("RefundAttemptInitiatedBy", fields: [initiatedById], references: [id], onDelete: SetNull)
  errorMessage               String?
  startedAt                  DateTime            @default(now())
  completedAt                DateTime?
  createdAt                  DateTime            @default(now())
  refund                     Refund              @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([refundId, attemptNumber])
  @@index([refundId, createdAt])
}

model InventoryMovement {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  actorId      Int
  delta        Int
  before       Int
  after        Int
  reason       String
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ingredientId, createdAt])
}

model Ingredient {
  movements      InventoryMovement[]
  id             Int                 @id @default(autoincrement())
  code           String              @unique
  name           String
  unit           String
  stock          Int                 @default(0)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  productRecipes ProductIngredient[]
  toppingRecipes ToppingIngredient[]
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  amountS      Int
  amountM      Int
  amountL      Int
  isRequired   Boolean    @default(true)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model ToppingIngredient {
  id           Int        @id @default(autoincrement())
  toppingCode  String
  ingredientId Int
  amount       Int
  isRequired   Boolean    @default(true)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([toppingCode, ingredientId])
  @@index([toppingCode])
}
