# Docker Compose defaults for local development. Change these values for your machine.
POSTGRES_DB=brewlite_scrum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=brewlite_local_dev
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
JWT_SECRET=
JWT_EXPIRES_IN=7d

# VNPAY Sandbox. Không commit giá trị thật của TMN_CODE và HASH_SECRET.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_PAYMENT_EXPIRY_MINUTES=15

# Phải đổi thành HTTPS public URL khi VNPAY gọi thật.
VNPAY_RETURN_URL=

# Build only: set to host if the Docker Engine supports it and package downloads stall.
BUILD_NETWORK=default

# Optional: reuse an existing local database volume when renaming the Compose project.
# Leave empty on a new machine.
POSTGRES_VOLUME_NAME=
POSTGRES_VOLUME_EXTERNAL=false
