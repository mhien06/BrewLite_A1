# Docker Compose defaults for local development. Change these values for your machine.
POSTGRES_DB=brewlite_scrum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=brewlite_local_dev
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: reuse an existing local database volume when renaming the Compose project.
# Leave empty on a new machine.
POSTGRES_VOLUME_NAME=
POSTGRES_VOLUME_EXTERNAL=false
